APP_ENV=development
DATABASE_PATH=runtime/nexora.sqlite3
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
MAX_USER_DATASET_STORAGE_MB=250
MAX_TOTAL_DATASET_STORAGE_MB=2048
MAX_DATASETS_PER_USER=100
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=runtime/datasets
# Set STORAGE_BACKEND=s3 and configure these server-side for deployment.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional Groq credentials retained for future LLM integration; deterministic dataset chat does not call this provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_SECONDS=20
# Optional local fallback. Configure an already-installed local model only.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=20
# Optional generic provider used for ML insight summaries, not Analyst Chat
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
